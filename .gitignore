# Everything listed here can be regenerated by following README.md ("Build from a fresh copy").

# Python / uv  (recreate with: uv sync)
.venv/
__pycache__/
*.py[cod]

# PyInstaller output. The .exe is never committed: everyone builds it from source with
#   uv run python build_exe.py      (see README, "Build from a fresh copy")
build/
dist/
*.spec
*.exe

# App icon  (recreate with: uv run python make_icon.py)
assets/

# Station data, history, caches and exports  (recreate with: uv run python citybikes.py snapshot)
# landmarks.csv is hand-made, so it stays in the repository.
data/*
!data/landmarks.csv

# Editor / OS clutter
.vscode/
.idea/
Thumbs.db
.DS_Store
